+import type { DeliverySchedule } from './schedule-delivery.ts';
+
+export type DeliveryMetadata = {
+  delayed: boolean;
+  label: string;
+};
+
+export const describeDelivery = (schedule: DeliverySchedule): DeliveryMetadata => ({
+  // SMOKE: updated-intentional-rewrite
+  // SMOKE: review-group-current
+  delayed: schedule.reason === 'quiet-hours',
+  label:
+    schedule.reason === 'quiet-hours'
+      ? `Deferred ${schedule.channel} delivery`
+      : `Immediate ${schedule.channel} delivery`,
+  retryable: schedule.reason !== 'quiet-hours',
+  source: 'rewritten-version',
+});
