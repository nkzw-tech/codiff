diff --git a/src/infrastructure/preference-audit.ts b/src/infrastructure/preference-audit.ts
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/preference-audit.ts
@@ -0,0 +1,29 @@
+import type { PreferenceChange } from '../application/update-preferences.ts';
+
+export type PreferenceAuditRecord = {
+  changes: ReadonlyArray<PreferenceChange>;
+  revision: number;
+  userId: string;
+};
+
+export type PreferenceAudit = {
+  append(record: PreferenceAuditRecord): Promise<void>;
+  list(userId: string): Promise<ReadonlyArray<PreferenceAuditRecord>>;
+};
+
+export const createMemoryPreferenceAudit = (): PreferenceAudit => {
+  const records = new Map<string, Array<PreferenceAuditRecord>>();
+  return {
+    async append(record) {
+      const userRecords = records.get(record.userId) ?? [];
+      userRecords.push(record);
+      records.set(record.userId, userRecords);
+    },
+    async list(userId) {
+      return [...(records.get(userId) ?? [])];
+    },
+  };
+};
