@@ -10,3 +12,15 @@ export const parsePreferenceChange = (value: string): PreferenceChange => {
     enabled: enabled === 'on',
   };
 };
+
+export const parseQuietHours = (value: string): QuietHours => {
+  const [timezone, startMinute, endMinute] = value.split(':');
+  if (!timezone || !startMinute || !endMinute) {
+    throw new Error('Expected timezone:startMinute:endMinute.');
+  }
+  return {
+    endMinute: Number(endMinute),
+    startMinute: Number(startMinute),
+    timezone,
+  };
+};
diff --git a/test/delivery-schedule.test.ts b/test/delivery-schedule.test.ts
new file mode 100644
--- /dev/null
+++ b/test/delivery-schedule.test.ts
@@ -0,0 +1,26 @@
+import { scheduleDelivery } from '../src/application/schedule-delivery.ts';
+import { defaultPreferences } from '../src/domain/preferences.ts';
+
+const preferences = defaultPreferences('ada');
+const now = new Date('2026-07-23T22:30:00.000Z');
+const scheduled = scheduleDelivery(
+  preferences,
+  'product',
+  'push',
+  { endMinute: 420, startMinute: 1_200, timezone: 'America/Chicago' },
+  now,
+);
+
+if (!scheduled || scheduled.reason !== 'quiet-hours') {
+  throw new Error('Expected product push delivery to respect quiet hours.');
+}
+
+const security = scheduleDelivery(
+  preferences,
+  'security',
+  'sms',
+  { endMinute: 420, startMinute: 1_200, timezone: 'America/Chicago' },
+  now,
+);
+
+if (!security || security.deliverAt.getTime() !== now.getTime()) {
+  throw new Error('Expected security delivery to bypass quiet hours.');
+}
