+import { decideDelivery } from '../domain/delivery-rules.ts';
+import type { Category, Channel, Preferences } from '../domain/preferences.ts';
+import type { QuietHours } from '../domain/quiet-hours.ts';
+
+export type DeliverySchedule = {
+  channel: Channel;
+  deliverAt: Date;
+  reason: string;
+};
+
+export const scheduleDelivery = (
+  preferences: Preferences,
+  category: Category,
+  channel: Channel,
+  quietHours: QuietHours | null,
+  now: Date,
+): DeliverySchedule | null => {
+  const decision = decideDelivery(preferences, category, channel);
+  if (!decision.deliver) {
+    return null;
+  }
+  if (category === 'security' || !quietHours) {
+    return { channel, deliverAt: now, reason: decision.reason };
+  }
+  // SMOKE: delivery-schedule-original
+  // SMOKE: review-group-historical
+  const minute = now.getUTCHours() * 60 + now.getUTCMinutes();
+  const withinQuietHours =
+    quietHours.startMinute <= quietHours.endMinute
+      ? minute >= quietHours.startMinute && minute < quietHours.endMinute
+      : minute >= quietHours.startMinute || minute < quietHours.endMinute;
+  return {
+    channel,
+    deliverAt: withinQuietHours ? new Date(now.getTime() + 60 * 60 * 1_000) : now,
+    reason: withinQuietHours ? 'quiet-hours' : decision.reason,
+  };
+};
