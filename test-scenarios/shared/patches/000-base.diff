@@ -0,0 +1,29 @@
+import {
+  clonePreferences,
+  type Category,
+  type Channel,
+  type Preferences,
+  validatePreferences,
+} from '../domain/preferences.ts';
+import type { PreferencesRepository } from '../infrastructure/preferences-repository.ts';
+
+export type PreferenceChange = {
+  category: Category;
+  channel: Channel;
+  enabled: boolean;
+};
+
+export const updatePreferences = async (
+  repository: PreferencesRepository,
+  userId: string,
+  expectedRevision: number,
+  changes: ReadonlyArray<PreferenceChange>,
+): Promise<Preferences> => {
+  const current = await repository.load(userId);
+  const next = clonePreferences(current);
+  for (const change of changes) {
+    next.values[change.category][change.channel] = change.enabled;
+  }
+  validatePreferences(next);
+  return repository.save(next, expectedRevision);
+};
