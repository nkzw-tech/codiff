+export const channels = ['email', 'push', 'sms'] as const;
+export const categories = ['security', 'product', 'marketing'] as const;
+
+export type Channel = (typeof channels)[number];
+export type Category = (typeof categories)[number];
+
+export type PreferenceMatrix = Record<Category, Record<Channel, boolean>>;
+
+export type Preferences = {
+  revision: number;
+  userId: string;
+  values: PreferenceMatrix;
+};
+
+export const defaultPreferences = (userId: string): Preferences => ({
+  revision: 0,
+  userId,
+  values: {
+    marketing: { email: false, push: false, sms: false },
+    product: { email: true, push: true, sms: false },
+    security: { email: true, push: true, sms: true },
+  },
+});
+
+export const clonePreferences = (preferences: Preferences): Preferences => ({
+  ...preferences,
+  values: {
+    marketing: { ...preferences.values.marketing },
+    product: { ...preferences.values.product },
+    security: { ...preferences.values.security },
+  },
+});
+
+export const validatePreferences = (preferences: Preferences) => {
+  for (const category of categories) {
+    for (const channel of channels) {
+      if (typeof preferences.values[category][channel] !== 'boolean') {
+        throw new Error(`Preference ${category}.${channel} must be boolean.`);
+      }
+    }
+  }
+  return preferences;
+};
