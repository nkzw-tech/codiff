--- /dev/null
+++ b/test/preferences.test.ts
@@ -0,0 +1,14 @@
+import { decideDelivery } from '../src/domain/delivery-rules.ts';
+import { defaultPreferences } from '../src/domain/preferences.ts';
+
+const preferences = defaultPreferences('ada');
+
+const productEmail = decideDelivery(preferences, 'product', 'email');
+if (!productEmail.deliver) {
+  throw new Error('Expected product email delivery.');
+}
+
+const marketingSms = decideDelivery(preferences, 'marketing', 'sms');
+if (marketingSms.deliver) {
+  throw new Error('Expected marketing SMS suppression.');
+}
