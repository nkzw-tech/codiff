+++ b/src/domain/delivery-rules.ts
@@ -0,0 +1,20 @@
+import type { Category, Channel, Preferences } from './preferences.ts';
+
+export type DeliveryDecision = {
+  channel: Channel;
+  deliver: boolean;
+  reason: 'enabled' | 'security-override' | 'suppressed';
+};
+
+export const decideDelivery = (
+  preferences: Preferences,
+  category: Category,
+  channel: Channel,
+): DeliveryDecision => {
+  if (category === 'security') {
+    return { channel, deliver: true, reason: 'security-override' };
+  }
+  return preferences.values[category][channel]
+    ? { channel, deliver: true, reason: 'enabled' }
+    : { channel, deliver: false, reason: 'suppressed' };
+};
diff --git a/src/infrastructure/preferences-repository.ts b/src/infrastructure/preferences-repository.ts
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/preferences-repository.ts
@@ -0,0 +1,34 @@
+import {
+  clonePreferences,
+  defaultPreferences,
+  type Preferences,
+} from '../domain/preferences.ts';
+
+export type PreferencesRepository = {
+  load(userId: string): Promise<Preferences>;
+  save(preferences: Preferences, expectedRevision: number): Promise<Preferences>;
+};
+
+export const createMemoryPreferencesRepository = (): PreferencesRepository => {
+  const records = new Map<string, Preferences>();
+  return {
+    async load(userId) {
+      const existing = records.get(userId);
+      if (existing) {
+        return clonePreferences(existing);
+      }
+      const created = defaultPreferences(userId);
+      records.set(userId, created);
+      return clonePreferences(created);
+    },
+    async save(preferences, expectedRevision) {
+      const current = await this.load(preferences.userId);
+      if (current.revision !== expectedRevision) {
+        throw new Error(`Preference revision changed from ${expectedRevision} to ${current.revision}.`);
+      }
+      const next = { ...clonePreferences(preferences), revision: expectedRevision + 1 };
+      records.set(next.userId, next);
+      return clonePreferences(next);
+    },
+  };
+};
