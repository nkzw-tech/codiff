+++ b/src/api/preferences-handler.ts
@@ -0,0 +1,25 @@
+import type { PreferenceChange } from '../application/update-preferences.ts';
+import type { PreferencesRepository } from '../infrastructure/preferences-repository.ts';
+import { updatePreferences } from '../application/update-preferences.ts';
+
+export type UpdatePreferencesRequest = {
+  changes: ReadonlyArray<PreferenceChange>;
+  expectedRevision: number;
+  userId: string;
+};
+
+export const handleUpdatePreferences = async (
+  repository: PreferencesRepository,
+  request: UpdatePreferencesRequest,
+) => {
+  const preferences = await updatePreferences(
+    repository,
+    request.userId,
+    request.expectedRevision,
+    request.changes,
+  );
+  return {
+    revision: preferences.revision,
+    values: preferences.values,
+  };
+};
