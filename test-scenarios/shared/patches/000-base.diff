+import type { PreferenceChange } from '../application/update-preferences.ts';
+
+export const parsePreferenceChange = (value: string): PreferenceChange => {
+  const [category, channel, enabled] = value.split(':');
+  if (!category || !channel || (enabled !== 'on' && enabled !== 'off')) {
+    throw new Error('Expected category:channel:on|off.');
+  }
+  return {
+    category: category as PreferenceChange['category'],
+    channel: channel as PreferenceChange['channel'],
+    enabled: enabled === 'on',
+  };
+};
