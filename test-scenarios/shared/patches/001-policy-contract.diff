@@ -0,0 +1,24 @@
+export type QuietHours = {
+  endMinute: number;
+  startMinute: number;
+  timezone: string;
+};
+
+export const validateQuietHours = (quietHours: QuietHours) => {
+  if (
+    !Number.isInteger(quietHours.startMinute) ||
+    !Number.isInteger(quietHours.endMinute) ||
+    quietHours.startMinute < 0 ||
+    quietHours.startMinute > 1_439 ||
+    quietHours.endMinute < 0 ||
+    quietHours.endMinute > 1_439
+  ) {
+    throw new Error('Quiet hours must use minutes between 0 and 1439.');
+  }
+  if (!quietHours.timezone) {
+    throw new Error('Quiet hours require a timezone.');
+  }
+  return quietHours;
+};
