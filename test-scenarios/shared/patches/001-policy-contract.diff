+
+const quietHours = validateQuietHours({
+  endMinute: 420,
+  startMinute: 1_320,
+  timezone: 'America/Chicago',
+});
+
+if (quietHours.timezone !== 'America/Chicago') {
+  throw new Error('Expected timezone to survive validation.');
+}
