new file mode 100644
--- /dev/null
+++ b/test/preferences-audit.test.ts
@@ -0,0 +1,32 @@
+import { updatePreferences } from '../src/application/update-preferences.ts';
+import { createMemoryPreferenceAudit } from '../src/infrastructure/preference-audit.ts';
+import { createMemoryPreferencesRepository } from '../src/infrastructure/preferences-repository.ts';
+
+const repository = createMemoryPreferencesRepository();
+const audit = createMemoryPreferenceAudit();
+
+const updated = await updatePreferences(
+  repository,
+  'ada',
+  0,
+  [{ category: 'marketing', channel: 'email', enabled: true }],
+  audit,
+);
+
+if (updated.revision !== 1) {
+  throw new Error('Expected preference revision to advance.');
+}
+
+const records = await audit.list('ada');
+if (records.length !== 1 || records[0]?.changes[0]?.channel !== 'email') {
+  throw new Error('Expected audit record for preference update.');
+}
+
+try {
+  await updatePreferences(repository, 'ada', 0, [], audit);
+  throw new Error('Expected stale preference revision to fail.');
+} catch (error) {
+  if (!(error instanceof Error)) {
+    throw error;
+  }
+}
